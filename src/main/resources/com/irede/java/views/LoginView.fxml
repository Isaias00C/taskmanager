<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="640.0" prefWidth="640.0" styleClass="root"
           xmlns="http://javafx.com/javafx/26"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.irede.java.controllers.LoginController">

    <VBox styleClass="card" alignment="TOP_LEFT" spacing="6.0"
          maxWidth="340.0" maxHeight="-Infinity">
        <padding>
            <Insets top="28.0" right="28.0" bottom="28.0" left="28.0" />
        </padding>

        <Label text="Login" styleClass="title" />
        <Label text="Entre com seu email e senha" styleClass="subtitle" />

        <Label text="Email" styleClass="field-label" />
        <TextField fx:id="emailField" promptText="voce@exemplo.com" />

        <Label text="Senha" styleClass="field-label" />
        <PasswordField fx:id="senhaField" />

        <Button text="Login" onAction="#onLogin" defaultButton="true"
                styleClass="primary-button" maxWidth="Infinity">
            <VBox.margin>
                <Insets top="14.0" />
            </VBox.margin>
        </Button>

        <HBox alignment="CENTER" spacing="2.0">
            <Label text="Ainda não tenho cadastro," styleClass="subtitle" />
            <Hyperlink fx:id="linkSignIn" text="cadastrar" onAction="#onGoToSignIn" />
            <VBox.margin>
                <Insets top="6.0" />
            </VBox.margin>
        </HBox>
    </VBox>
</StackPane>