<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.irede.java.controller.PrimaryController"
    prefHeight="400" prefWidth="500">
    <top>
        <VBox spacing="10">
            <padding><Insets top="15" right="10" left="15"/></padding>
            <Label text="cadastro de pessoas" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <HBox>
                <TextField fx:id="txtNome" promptText="informe seu nome"/>
                <Button fx:id="btnAdicionar" text="adicionar" onAction="#adicionarNome"/>
            </HBox>
        </VBox>
    </top>
</BorderPane>
