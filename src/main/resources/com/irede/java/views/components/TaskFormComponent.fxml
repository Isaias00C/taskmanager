<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<GridPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/fxml/21"
          fx:controller="com.irede.java.controllers.TaskFormController"
          hgap="10" vgap="10"
          style="-fx-padding: 12; -fx-border-color: #cccccc; -fx-border-radius: 4; -fx-background-color: #f7f7f7;">

    <columnConstraints>
        <ColumnConstraints minWidth="100" />
        <ColumnConstraints hgrow="ALWAYS" />
    </columnConstraints>

    <Label text="Nome:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
    <TextField fx:id="txtName" GridPane.rowIndex="0" GridPane.columnIndex="1" />

    <Label text="Descrição:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
    <TextArea fx:id="txtDescription" prefRowCount="3" wrapText="true" GridPane.rowIndex="1" GridPane.columnIndex="1" />

    <Label text="Status:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
    <ComboBox fx:id="cmbStatus" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1" />

    <Label text="Atribuido à:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
    <ComboBox fx:id="cmbAssignTo" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1" />

    <HBox spacing="10" GridPane.rowIndex="4" GridPane.columnIndex="1">
        <Button fx:id="btnSave" text="Salvar" onAction="#handleSave" />
        <Button text="Cancelar" onAction="#handleCancel" />
    </HBox>

</GridPane>